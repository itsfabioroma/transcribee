# ElevenLabs API key for speech-to-text transcription
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key_here

# Optional: use Atlas Cloud for speech-to-text instead of the default ElevenLabs provider
# ASR_PROVIDER=atlascloud
# ATLASCLOUD_API_KEY=your_atlascloud_api_key_here
# ATLASCLOUD_API_BASE=https://api.atlascloud.ai/api/v1
# ATLASCLOUD_ASR_MODEL=bytedance/seed-asr-2.0

# Anthropic API key for theme classification
ANTHROPIC_API_KEY=your_anthropic_api_key_here
