# Impossibl gateway: one key for transcription (ElevenLabs Scribe v2) and classification (Claude)
IMPOSSIBL_API_KEY=your_impossibl_api_key_here
# Optional: ASR_LANGUAGE=en          # skip auto-detection
# Optional: ANTHROPIC_MODEL=anthropic/claude-haiku-4-5
# Optional: IMPOSSIBL_ASR_MODEL=elevenlabs/scribe-v2
# Optional upload limits. Size defaults to the model's max_file_size_bytes from GET /v1/models
# (5 GB for Scribe v2; 25 MB if that lookup fails); duration defaults to 10 h.
# Chunking happens only past these or on a 413.
# IMPOSSIBL_MAX_UPLOAD_MB=1024
# IMPOSSIBL_MAX_DURATION_HOURS=10

# Optional fallbacks. Used automatically if IMPOSSIBL_API_KEY is missing,
# or explicitly via ASR_PROVIDER=elevenlabs|atlascloud and LLM_PROVIDER=anthropic
# ELEVEN_LABS_API_KEY=your_elevenlabs_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ATLASCLOUD_API_KEY=your_atlascloud_api_key_here
# ATLASCLOUD_API_BASE=https://api.atlascloud.ai/api/v1
# ATLASCLOUD_ASR_MODEL=bytedance/seed-asr-2.0
